<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Password Strength Meter</title>
<style>
  * { box-sizing: border-box; font-family: Arial, sans-serif; }
  body {
    background: #0d1117;
    color: #e6edf3;
    display: flex;
    justify-content: center;
    padding: 60px 15px;
  }
  .card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 24px;
    width: 100%;
    max-width: 360px;
  }
  h1 { font-size: 18px; color: #58a6ff; margin-top: 0; }
  input {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #30363d;
    background: #0d1117;
    color: #e6edf3;
    font-size: 14px;
  }
  .bar-bg {
    width: 100%;
    height: 8px;
    background: #21262d;
    border-radius: 5px;
    margin-top: 12px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    transition: width 0.25s ease, background 0.25s ease;
  }
  .label {
    margin-top: 8px;
    font-size: 13px;
    font-weight: bold;
  }
  .tips {
    margin-top: 14px;
    font-size: 12px;
    color: #8b949e;
    line-height: 1.6;
  }
  .tips span { display: block; }
  .met { color: #3fb950; }
</style>
</head>
<body>

<div class="card">
  <h1>🔐 Password Strength Meter</h1>
  <input type="text" id="pwInput" placeholder="Type a password...">

  <div class="bar-bg">
    <div class="bar-fill" id="barFill"></div>
  </div>
  <div class="label" id="strengthLabel">Enter a password</div>

  <div class="tips" id="tips"></div>
</div>

<script>
/* ============================================================
   PASSWORD STRENGTH METER
   Concepts practiced: variables, functions, conditionals, loops,
   string methods, arrays, template literals, DOM manipulation,
   and events (real-time input).
   ============================================================ */

// DOM references, grabbed once
const pwInput = document.getElementById("pwInput");
const barFill = document.getElementById("barFill");
const strengthLabel = document.getElementById("strengthLabel");
const tipsBox = document.getElementById("tips");

// ---------- FUNCTION: checkRules ----------
// Returns an ARRAY of objects, each describing one rule and
// whether the current password passes it. Keeping rules as
// data (not scattered if-statements) makes this easy to extend.
function checkRules(password) {
  return [
    { label: "At least 8 characters", passed: password.length >= 8 },
    { label: "Contains a number", passed: /[0-9]/.test(password) },
    { label: "Contains an uppercase letter", passed: /[A-Z]/.test(password) },
    { label: "Contains a special character (!@#$ etc.)", passed: /[^A-Za-z0-9]/.test(password) },
  ];
}

// ---------- FUNCTION: getStrengthInfo ----------
// Takes the score (how many rules passed) and returns a label + color.
// Simple conditional logic — no magic, just readable if/else steps.
function getStrengthInfo(score, total) {
  if (score === 0) {
    return { label: "Enter a password", color: "#30363d" };
  } else if (score <= total / 2) {
    return { label: "Weak", color: "#f85149" };
  } else if (score < total) {
    return { label: "Medium", color: "#f0883e" };
  } else {
    return { label: "Strong", color: "#3fb950" };
  }
}

// ---------- FUNCTION: updateMeter ----------
// Runs on every keystroke. Ties everything together:
// checks rules, calculates score, updates the bar + tips list.
function updateMeter() {
  const password = pwInput.value;
  const rules = checkRules(password);

  // .filter() + .length is a common way to COUNT how many
  // items in an array meet a condition.
  const score = rules.filter((rule) => rule.passed).length;
  const total = rules.length;

  const { label, color } = getStrengthInfo(score, total);

  // Update the progress bar width and color
  const percent = (score / total) * 100;
  barFill.style.width = `${percent}%`;
  barFill.style.background = color;

  // Update the text label
  strengthLabel.textContent = label;
  strengthLabel.style.color = color;

  // Build the checklist of tips using .map() + template literals
  tipsBox.innerHTML = rules
    .map((rule) => {
      // Conditional class + checkmark based on whether the rule passed
      const icon = rule.passed ? "✅" : "❌";
      const cssClass = rule.passed ? "met" : "";
      return `<span class="${cssClass}">${icon} ${rule.label}</span>`;
    })
    .join("");
}

// ---------- EVENT LISTENER ----------
// 'input' fires on every keystroke, making this feel real-time.
pwInput.addEventListener("input", updateMeter);

// Run once on load so the tips list shows immediately
updateMeter();
</script>

</body>
</html>
