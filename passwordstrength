<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Password Strength Meter</title>
<style>
  * { box-sizing: border-box; font-family: Arial, sans-serif; }
  body {
    background: #0d1117;
    color: #e6edf3;
    display: flex;
    justify-content: center;
    padding: 60px 15px;
  }
  .card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 24px;
    width: 100%;
    max-width: 360px;
  }
  h1 { font-size: 18px; color: #58a6ff; margin-top: 0; }
  input {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid #30363d;
    background: #0d1117;
    color: #e6edf3;
    font-size: 14px;
  }
  .bar-bg {
    width: 100%;
    height: 8px;
    background: #21262d;
    border-radius: 5px;
    margin-top: 12px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 5px;
    transition: width 0.25s ease, background 0.25s ease;
  }
  .label {
    margin-top: 8px;
    font-size: 13px;
    font-weight: bold;
  }
  .tips {
    margin-top: 14px;
    font-size: 12px;
    color: #8b949e;
    line-height: 1.6;
  }
  .tips span { display: block; }
  .met { color: #3fb950; }
</style>
</head>
<body>

<div class="card">
  <h1>🔐 Password Strength Meter</h1>
  <input type="text" id="pwInput" placeholder="Type a password...">

  <div class="bar-bg">
    <div class="bar-fill" id="barFill"></div>
  </div>
  <div class="label" id="strengthLabel">Enter a password</div>

  <div class="tips" id="tips"></div>
</div>

