<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Rock Paper Scissors</title>
<style>
  * { box-sizing: border-box; font-family: Arial, sans-serif; }
  body {
    background: #0d1117;
    color: #e6edf3;
    display: flex;
    justify-content: center;
    padding: 50px 15px;
  }
  .card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 24px;
    width: 100%;
    max-width: 380px;
    text-align: center;
  }
  h1 { font-size: 18px; color: #58a6ff; margin-top: 0; }

  .scoreboard {
    display: flex;
    justify-content: space-around;
    margin: 16px 0;
    font-size: 13px;
    color: #8b949e;
  }
  .scoreboard .num { font-size: 20px; font-weight: bold; color: #e6edf3; display: block; }

  .choices { display: flex; justify-content: center; gap: 12px; margin: 20px 0; }
  .choice-btn {
    font-size: 28px;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 14px 16px;
    cursor: pointer;
  }
  .choice-btn:hover { border-color: #58a6ff; }

  .result-box {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 16px;
    min-height: 60px;
  }
  .vs-line { font-size: 15px; margin-bottom: 6px; }
  .verdict { font-weight: bold; font-size: 14px; }
  .win { color: #3fb950; }
  .lose { color: #f85149; }
  .draw { color: #f0883e; }

  .streak { margin-top: 10px; font-size: 12px; color: #8b949e; }
  .reset-btn {
    margin-top: 14px;
    padding: 8px 14px;
    background: #30363d;
    border: none;
    border-radius: 6px;
    color: #e6edf3;
    cursor: pointer;
  }
  .reset-btn:hover { background: #3d444d; }
</style>
</head>
<body>

<div class="card">
  <h1>✊✋✌️ Rock Paper Scissors</h1>

  <div class="scoreboard">
    <div>You <span class="num" id="playerScore">0</span></div>
    <div>Draws <span class="num" id="drawScore">0</span></div>
    <div>Computer <span class="num" id="computerScore">0</span></div>
  </div>

  <div class="choices">
    <button class="choice-btn" onclick="play('rock')">✊</button>
    <button class="choice-btn" onclick="play('paper')">✋</button>
    <button class="choice-btn" onclick="play('scissors')">✌️</button>
  </div>
  <div class="result-box" id="resultBox">
    <div class="vs-line">Make your move to start</div>
  </div>

  <div class="streak" id="streakLabel"></div>
  <button class="reset-btn" onclick="resetGame()">Reset Scores</button>
</div>

<script>
/* ============================================================
   ROCK PAPER SCISSORS
   Concepts practiced: variables, functions, conditionals
   (including nested logic for win/lose/draw rules), objects,
   arrays, template literals, DOM manipulation, events.
   ============================================================ */
// ---------- 1. GAME DATA ----------
const CHOICES = ["rock", "paper", "scissors"];
const EMOJI = { rock: "✊", paper: "✋", scissors: "✌️" };

// ---------- 2. RULES TABLE ----------
// Instead of writing long if/else chains for every matchup,
// we store the rule as DATA: "what beats what". This object
// says "rock beats scissors", "paper beats rock", etc.
// This is the same lookup-table pattern from the Morse project.
const BEATS = {
  rock: "scissors",
  paper: "rock",
  scissors: "paper",
};

// ---------- 3. STATE ----------
let scores = { player: 0, computer: 0, draws: 0 };
let currentStreak = 0;

// ---------- 4. FUNCTION: getComputerChoice ----------
function getComputerChoice() {
  const randomIndex = Math.floor(Math.random() * CHOICES.length);
  return CHOICES[randomIndex];
}
// ---------- 5. FUNCTION: decideWinner ----------
// Takes both choices and returns "player", "computer", or "draw".
// Uses the BEATS lookup table instead of writing out every
// possible combination by hand.
function decideWinner(playerChoice, computerChoice) {
  if (playerChoice === computerChoice) {
    return "draw";
  }
  // If the thing the player picked "beats" what the computer picked,
  // the player wins. Otherwise, the computer wins.
  if (BEATS[playerChoice] === computerChoice) {
    return "player";
  }
  return "computer";
}
// ---------- 6. FUNCTION: play ----------
// Runs when the user clicks a choice button.
function play(playerChoice) {
  const computerChoice = getComputerChoice();
  const winner = decideWinner(playerChoice, computerChoice);

  updateScores(winner);
  updateStreak(winner);
  renderResult(playerChoice, computerChoice, winner);
  renderScoreboard();
}

// ---------- 7. FUNCTION: updateScores ----------
function updateScores(winner) {
  if (winner === "player") {
    scores.player++;
  } else if (winner === "computer") {
    scores.computer++;
  } else {
    scores.draws++;
  }
}

// ---------- 8. FUNCTION: updateStreak ----------
function updateStreak(winner) {
  if (winner === "player") {
    // Only increase the streak if it was already a winning streak,
    // otherwise start a fresh one at 1.
    currentStreak = currentStreak > 0 ? currentStreak + 1 : 1;
  } else if (winner === "computer") {
    currentStreak = currentStreak < 0 ? currentStreak - 1 : -1;
  } else {
    currentStreak = 0; // a draw breaks any streak
  }
}

