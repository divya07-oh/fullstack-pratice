<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DHTML Mini Project - Task Manager</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    padding: 40px 20px;
}

.container {
    width: 100%;
    max-width: 700px;
    margin: auto;
    background: white;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}

h1 {
    text-align: center;
    color: #333;
    margin-bottom: 10px;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
}

.input-area {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

#taskInput {
    flex: 1;
    padding: 13px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
}

#taskInput:focus {
    border-color: #667eea;
}

button {
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
}

.add-btn {
    background: #667eea;
    color: white;
}

.add-btn:hover {
    background: #5568d8;
}

.filters {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
}

.filter-btn {
    background: #eee;
    color: #444;
}

.filter-btn.active {
    background: #667eea;
    color: white;
}
#taskList {
    list-style: none;
}

.task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px;
    margin-bottom: 10px;
    background: #f7f7f7;
    border-radius: 8px;
    border-left: 5px solid #667eea;
}

.task.completed {
    opacity: 0.6;
    border-left-color: #28a745;
}

.task.completed .task-text {
    text-decoration: line-through;
}

.task-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
}

.task-content input {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.task-text {
    font-size: 16px;
    color: #333;
    word-break: break-word;
}

.actions {
    display: flex;
    gap: 6px;
}

.edit-btn {
    background: #ffc107;
    color: #222;
}

.delete-btn {
    background: #dc3545;
    color: white;
}

.empty {
    text-align: center;
    color: #888;
    padding: 25px;
}

.stats {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #ddd;
    color: #666;
}

.clear-btn {
    background: #333;
    color: white;
}

.clear-btn:hover {
    background: #111;
}

@media (max-width: 600px) {
    .container {
        padding: 20px;
    }

    .input-area {
        flex-direction: column;
    }

    .filters {
        flex-wrap: wrap;
    }

    .task {
        align-items: flex-start;
        gap: 10px;
    }

    .actions {
        flex-direction: column;
    }
}
</style>
</head>
<body>

<div class="container">

    <h1>My Task Manager</h1>
    <p class="subtitle">DHTML Mini Project</p>

    <div class="input-area">
        <input
            type="text"
            id="taskInput"
            placeholder="Enter a new task..."
            onkeypress="handleKey(event)"
        >
        <button class="add-btn" onclick="addTask()">Add Task</button>
    </div>

    <div class="filters">
        <button class="filter-btn active" onclick="setFilter('all', this)">
            All
        </button>

        <button class="filter-btn" onclick="setFilter('active', this)">
            Active
        </button>

        <button class="filter-btn" onclick="setFilter('completed', this)">
            Completed
        </button>
    </div>

    <ul id="taskList"></ul>

    <div class="stats">
        <span id="taskCount">0 tasks</span>
        <button class="clear-btn" onclick="clearCompleted()">
            Clear Completed
        </button>
    </div>

</div>

<script>

let tasks = [];
let currentFilter = "all";
let editIndex = -1;

function addTask() {

    const input = document.getElementById("taskInput");
    const text = input.value.trim();

    if (text === "") {
        alert("Please enter a task!");
        return;
    }

    if (editIndex !== -1) {
        tasks[editIndex].text = text;
        editIndex = -1;
    } else {
        tasks.push({
            text: text,
            completed: false
        });
    }

    input.value = "";
    renderTasks();
}

function handleKey(event) {

    if (event.key === "Enter") {
        addTask();
    }
}

function renderTasks() {

    const list = document.getElementById("taskList");

    list.innerHTML = "";

    let filteredTasks = tasks.filter(function(task) {

        if (currentFilter === "active") {
            return !task.completed;
        }

        if (currentFilter === "completed") {
            return task.completed;
        }

        return true;
    });

    if (filteredTasks.length === 0) {

        const empty = document.createElement("li");

        empty.className = "empty";

        empty.textContent = "No tasks found.";

        list.appendChild(empty);

    } else {

        filteredTasks.forEach(function(task) {

            const originalIndex = tasks.indexOf(task);

            const li = document.createElement("li");

            li.className = "task";

            if (task.completed) {
                li.classList.add("completed");
            }

            const content = document.createElement("div");

            content.className = "task-content";

            const checkbox = document.createElement("input");

            checkbox.type = "checkbox";

            checkbox.checked = task.completed;

            checkbox.onclick = function() {
                toggleTask(originalIndex);
            };

            const text = document.createElement("span");

            text.className = "task-text";

            text.textContent = task.text;

            content.appendChild(checkbox);

            content.appendChild(text);

            const actions = document.createElement("div");

            actions.className = "actions";

            const editButton = document.createElement("button");

            editButton.className = "edit-btn";

            editButton.textContent = "Edit";

            editButton.onclick = function() {
                editTask(originalIndex);
            };

            const deleteButton = document.createElement("button");

            deleteButton.className = "delete-btn";

            deleteButton.textContent = "Delete";

            deleteButton.onclick = function() {
                deleteTask(originalIndex);
            };

            actions.appendChild(editButton);

            actions.appendChild(deleteButton);

            li.appendChild(content);

            li.appendChild(actions);

            list.appendChild(li);
        });
    }

    updateCounter();
}

