<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DHTML Mini Project - Task Manager</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    padding: 40px 20px;
}

.container {
    width: 100%;
    max-width: 700px;
    margin: auto;
    background: white;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}

h1 {
    text-align: center;
    color: #333;
    margin-bottom: 10px;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
}

.input-area {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

#taskInput {
    flex: 1;
    padding: 13px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
}

#taskInput:focus {
    border-color: #667eea;
}

button {
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
}

.add-btn {
    background: #667eea;
    color: white;
}

.add-btn:hover {
    background: #5568d8;
}

.filters {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
}

.filter-btn {
    background: #eee;
    color: #444;
}

.filter-btn.active {
    background: #667eea;
    color: white;
}
#taskList {
    list-style: none;
}

.task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px;
    margin-bottom: 10px;
    background: #f7f7f7;
    border-radius: 8px;
    border-left: 5px solid #667eea;
}

.task.completed {
    opacity: 0.6;
    border-left-color: #28a745;
}

.task.completed .task-text {
    text-decoration: line-through;
}

.task-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
}

.task-content input {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.task-text {
    font-size: 16px;
    color: #333;
    word-break: break-word;
}

.actions {
    display: flex;
    gap: 6px;
}

.edit-btn {
    background: #ffc107;
    color: #222;
}

.delete-btn {
    background: #dc3545;
    color: white;
}

.empty {
    text-align: center;
    color: #888;
    padding: 25px;
}

.stats {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #ddd;
    color: #666;
}

.clear-btn {
    background: #333;
    color: white;
}

.clear-btn:hover {
    background: #111;
}

@media (max-width: 600px) {
    .container {
        padding: 20px;
    }

    .input-area {
        flex-direction: column;
    }

    .filters {
        flex-wrap: wrap;
    }

    .task {
        align-items: flex-start;
        gap: 10px;
    }

    .actions {
        flex-direction: column;
    }
}
</style>
</head>

