import React, { useState, useEffect, useRef } from "react";
import { Play, Pause, RotateCcw, Coffee, Brain } from "lucide-react";

/* ============================================================
   POMODORO FOCUS TIMER — a React mini-project
   Concepts practiced: components, props, state, conditional
   rendering, and useEffect (for the live countdown timer).
   ============================================================ */

const FOCUS_MINUTES = 25;
const BREAK_MINUTES = 5;

// ---------- CHILD COMPONENT: TimerDisplay ----------
// Purely presentational — receives everything it needs as PROPS
// and just renders it. Doesn't know anything about timers or state logic.
function TimerDisplay({ secondsLeft, mode }) {
  const minutes = Math.floor(secondsLeft / 60);
  const seconds = secondsLeft % 60;
  // padStart keeps "05" instead of "5" for a proper clock look
  const display = `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;

  return (
    <div className="text-center">
      {/* Conditional rendering: different icon + label depending on mode */}
      <div className="flex items-center justify-center gap-2 mb-2 text-sm">
        {mode === "focus" ? (
          <>
            <Brain size={16} className="text-amber-400" />
            <span className="text-amber-400 font-medium">Focus session</span>
          </>
        ) : (
          <>
            <Coffee size={16} className="text-emerald-400" />
            <span className="text-emerald-400 font-medium">Break time</span>
          </>
        )}
      </div>
      <div className="text-6xl font-bold text-slate-100 tabular-nums">{display}</div>
    </div>
  );
}

// ---------- CHILD COMPONENT: SessionLog ----------
// Receives an array of completed sessions as a prop and renders it.
function SessionLog({ sessions }) {
  // Conditional rendering: empty state vs list
  if (sessions.length === 0) {
    return <p className="text-slate-500 text-sm text-center mt-6">No sessions completed yet.</p>;
  }

  return (
    <div className="mt-6">
      <p className="text-slate-400 text-xs mb-2">Today's sessions</p>
      <div className="space-y-1">
        {sessions.map((session, index) => (
          <div key={index} className="flex justify-between text-xs text-slate-400 border-b border-slate-800 py-1">
            <span>{session.type === "focus" ? "🧠 Focus" : "☕ Break"}</span>
            <span>{session.time}</span>
          </div>
        ))}
      </div>
    </div>
  );
}
// ---------- PARENT COMPONENT: App ----------
export default function App() {
  const [mode, setMode] = useState("focus");          // "focus" or "break"
  const [secondsLeft, setSecondsLeft] = useState(FOCUS_MINUTES * 60);
  const [isRunning, setIsRunning] = useState(false);
  const [sessions, setSessions] = useState([]);

  // useRef holds the interval ID without triggering re-renders when it changes
  const intervalRef = useRef(null);

  // ---------- useEffect: the countdown engine ----------
  // Runs whenever `isRunning` changes. Starts or stops the interval accordingly.
  useEffect(() => {
    if (isRunning) {
      intervalRef.current = setInterval(() => {
        setSecondsLeft((prev) => {
          if (prev <= 1) {
            // Time's up — stop this interval, the effect below handles what's next
            clearInterval(intervalRef.current);
            return 0;
          }
          return prev - 1;
        });
      }, 1000);
    }
  // ---------- useEffect: reacts when the timer hits zero ----------
  useEffect(() => {
    if (secondsLeft === 0 && isRunning) {
      // Log the session that just finished
      setSessions((prev) => [
        { type: mode, time: new Date().toLocaleTimeString() },
        ...prev,
      ]);

      // Switch modes: focus -> break, break -> focus
      const nextMode = mode === "focus" ? "break" : "focus";
      setMode(nextMode);
      setSecondsLeft(nextMode === "focus" ? FOCUS_MINUTES * 60 : BREAK_MINUTES * 60);
      setIsRunning(false); // pause so the user consciously starts the next session
    }
  }, [secondsLeft, isRunning, mode]);

  function handleReset() {
    setIsRunning(false);
    setMode("focus");
    setSecondsLeft(FOCUS_MINUTES * 60);
  }

  return (
    <div className="min-h-screen bg-slate-950 flex items-center justify-center p-6">
      <div className="w-full max-w-sm bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <h1 className="text-lg font-bold text-slate-100 mb-6 text-center">🍅 Pomodoro Timer</h1>

        <TimerDisplay secondsLeft={secondsLeft} mode={mode} />

        <div className="flex justify-center gap-3 mt-6">
          <button
            onClick={() => setIsRunning(!isRunning)}
            className="flex items-center gap-2 bg-amber-400 text-slate-900 font-medium px-4 py-2 rounded-lg hover:bg-amber-300"
          >
            {/* Conditional rendering: Play vs Pause icon + label */}
            {isRunning ? <Pause size={16} /> : <Play size={16} />}
            {isRunning ? "Pause" : "Start"}
          </button>
          <button
            onClick={handleReset}
            className="flex items-center gap-2 border border-slate-700 text-slate-400 px-4 py-2 rounded-lg hover:text-slate-100 hover:border-slate-500"
          >
            <RotateCcw size={16} />
            Reset
          </button>
        </div>

        <SessionLog sessions={sessions} />
      </div>
    </div>
  );
}

  
