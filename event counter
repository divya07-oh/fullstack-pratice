<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Event Countdown Timer</title>
<style>
  * { box-sizing: border-box; font-family: Arial, sans-serif; }
  body {
    background: #0d1117;
    color: #e6edf3;
    display: flex;
    justify-content: center;
    padding: 60px 15px;
  }
  .card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 24px;
    width: 100%;
    max-width: 360px;
    text-align: center;
  }
  h1 { font-size: 18px; color: #58a6ff; margin-top: 0; }
  input {
    width: 100%;
    padding: 9px;
    margin: 6px 0;
    border-radius: 6px;
    border: 1px solid #30363d;
    background: #0d1117;
    color: #e6edf3;
    font-size: 14px;
  }
  button {
    width: 100%;
    padding: 10px;
    margin-top: 8px;
    background: #238636;
    border: none;
    border-radius: 6px;
    color: white;
    font-weight: bold;
    cursor: pointer;
  }
  button:hover { background: #2ea043; }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }
  .unit {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 12px 10px;
    min-width: 60px;
  }
  .unit .num { font-size: 24px; font-weight: bold; color: #3fb950; }
  .unit .label { font-size: 10px; color: #8b949e; margin-top: 2px; }

  .eventName { margin-top: 14px; font-size: 14px; color: #e6edf3; }
  .finished { color: #f0883e; font-weight: bold; margin-top: 14px; }
</style>
</head>
<body>

<div class="card">
  <h1>⏳ Event Countdown</h1>

  <input type="text" id="eventInput" placeholder="Event name (e.g. Exam Day)">
  <input type="datetime-local" id="dateInput">
  <button onclick="startCountdown()">Start Countdown</button>

  <div class="eventName" id="eventName"></div>

  <div class="countdown" id="countdownDisplay"></div>
</div>
<script>
