import React, { createContext, useContext, useReducer } from "react";
import { ShoppingCart, Plus, Minus, Trash2, Store } from "lucide-react";

const PRODUCTS = [
  { id: 1, name: "Mechanical Keyboard", price: 2499 },
  { id: 2, name: "Wireless Mouse", price: 899 },
  { id: 3, name: "USB-C Hub", price: 1299 },
  { id: 4, name: "Laptop Stand", price: 1599 },
];

const CartContext = createContext();

function cartReducer(state, action) {
  switch (action.type) {
    case "ADD_ITEM": {
      const existing = state.find((item) => item.id === action.product.id);
      if (existing) {
        return state.map((item) =>
          item.id === action.product.id ? { ...item, qty: item.qty + 1 } : item
        );
      }
      return [...state, { ...action.product, qty: 1 }];
    }
    case "INCREASE":
      return state.map((item) =>
        item.id === action.id ? { ...item, qty: item.qty + 1 } : item
      );
    case "DECREASE":
      return state
        .map((item) =>
          item.id === action.id ? { ...item, qty: item.qty - 1 } : item
        )
        .filter((item) => item.qty > 0);
    case "REMOVE":
      return state.filter((item) => item.id !== action.id);
    default:
      return state;
  }
}

function CartProvider({ children }) {
  const [cart, dispatch] = useReducer(cartReducer, []);
  return (
    <CartContext.Provider value={{ cart, dispatch }}>
      {children}
    </CartContext.Provider>
  );
}

function ProductCard({ product }) {
  const { dispatch } = useContext(CartContext);

  return (
    <div className="flex items-center justify-between bg-slate-800/60 border border-slate-700 rounded-lg px-4 py-3">
      <div>
        <p className="text-slate-100 text-sm font-medium">{product.name}</p>
        <p className="text-slate-500 text-xs">₹{product.price}</p>
      </div>
      <button
        onClick={() => dispatch({ type: "ADD_ITEM", product })}
        className="text-xs bg-amber-400 text-slate-900 font-medium px-3 py-1.5 rounded-md hover:bg-amber-300"
      >
        Add
      </button>
    </div>
  );
}

function CartPanel() {
  const { cart, dispatch } = useContext(CartContext);

  const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 mt-5">
      <div className="flex items-center gap-2 mb-3">
        <ShoppingCart size={16} className="text-amber-400" />
        <p className="text-slate-100 text-sm font-medium">Your Cart</p>
      </div>

      {cart.length === 0 ? (
        <p className="text-slate-500 text-xs">Cart is empty — add something above.</p>
      ) : (
        <>
          <div className="space-y-2">
            {cart.map((item) => (
              <div key={item.id} className="flex items-center justify-between text-xs">
                <span className="text-slate-300">{item.name}</span>
                <div className="flex items-center gap-2">
                  <button
                    onClick={() => dispatch({ type: "DECREASE", id: item.id })}
                    className="p-1 rounded bg-slate-800 hover:bg-slate-700"
                  >
                    <Minus size={11} />
                  </button>
                  <span className="text-slate-100 w-4 text-center">{item.qty}</span>
                  <button
                    onClick={() => dispatch({ type: "INCREASE", id: item.id })}
                    className="p-1 rounded bg-slate-800 hover:bg-slate-700"
                  >
                    <Plus size={11} />
                  </button>
                  <button
                    onClick={() => dispatch({ type: "REMOVE", id: item.id })}
                    className="p-1 rounded bg-slate-800 hover:bg-red-500/30 text-red-400 ml-1"
                  >
                    <Trash2 size={11} />
                  </button>
                </div>
              </div>
            ))}
          </div>
          <div className="border-t border-slate-800 mt-3 pt-3 flex justify-between text-sm">
            <span className="text-slate-400">Total</span>
            <span className="text-amber-400 font-bold">₹{total}</span>
          </div>
        </>
      )}
    </div>
  );
}

function Shop() {
  return (
    <div className="w-full max-w-sm">
      <div className="flex items-center gap-2 mb-4">
        <Store className="text-amber-400" size={22} />
        <h1 className="text-lg font-bold text-slate-100">Mini Shop</h1>
      </div>

      <div className="space-y-2">
        {PRODUCTS.map((product) => (
          <ProductCard key={product.id} product={product} />
        ))}
      </div>

      <CartPanel />
    </div>
  );
}

export default function App() {
  return (
    <CartProvider>
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-6">
        <Shop />
      </div>
    </CartProvider>
  );
}
