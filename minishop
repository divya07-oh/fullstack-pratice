import React, { createContext, useContext, useReducer } from "react";
import { ShoppingCart, Plus, Minus, Trash2, Store } from "lucide-react";

/* ============================================================
   MINI SHOP — a React mini-project
   New concept introduced: the CONTEXT API.
   Until now, every project passed data down via props. That
   works fine for small apps, but imagine a "cart icon" nested
   5 components deep — you'd have to pass cartCount through
   every single component in between just to reach it
   ("prop drilling"). Context lets any component reach into
   shared state directly, without that chain.
   ============================================================ */

// ---------- 1. PRODUCT DATA ----------
const PRODUCTS = [
  { id: 1, name: "Mechanical Keyboard", price: 2499 },
  { id: 2, name: "Wireless Mouse", price: 899 },
  { id: 3, name: "USB-C Hub", price: 1299 },
  { id: 4, name: "Laptop Stand", price: 1599 },
];

// ---------- 2. CREATE THE CONTEXT ----------
// This is like creating a "channel" that any component can tune into.
const CartContext = createContext();

// ---------- 3. REDUCER FUNCTION ----------
// useReducer is like useState, but better suited for state with
// multiple related actions (add, remove, increase, decrease).
// It takes the current state + an "action" describing what happened,
// and returns the NEW state. Similar idea to a light switch:
// action.type tells the reducer which "switch" was flipped.
function cartReducer(state, action) {
  switch (action.type) {
    case "ADD_ITEM": {
      const existing = state.find((item) => item.id === action.product.id);
      if (existing) {
        // Already in cart — increase quantity using .map()
        return state.map((item) =>
          item.id === action.product.id ? { ...item, qty: item.qty + 1 } : item
        );
      }
      // New item — add it with qty 1
      return [...state, { ...action.product, qty: 1 }];
    }
    case "INCREASE":
      return state.map((item) =>
        item.id === action.id ? { ...item, qty: item.qty + 1 } : item
      );
    case "DECREASE":
      return state
        .map((item) =>
          item.id === action.id ? { ...item, qty: item.qty - 1 } : item
        )
        // Remove any item whose quantity dropped to 0
        .filter((item) => item.qty > 0);
    case "REMOVE":
      return state.filter((item) => item.id !== action.id);
    default:
      return state;
  }
}

// ---------- 4. CART PROVIDER ----------
// Wraps the app and makes cart state + dispatch available to
// EVERY component inside it, no matter how deeply nested.
function CartProvider({ children }) {
  const [cart, dispatch] = useReducer(cartReducer, []);
  return (
    <CartContext.Provider value={{ cart, dispatch }}>
      {children}
    </CartContext.Provider>
  );
}

// ---------- 5. CHILD COMPONENT: ProductCard ----------
// Notice: this component does NOT receive cart data as a prop.
// It reaches into CartContext directly using useContext.
function ProductCard({ product }) {
  const { dispatch } = useContext(CartContext);

  return (
    <div className="flex items-center justify-between bg-slate-800/60 border border-slate-700 rounded-lg px-4 py-3">
      <div>
        <p className="text-slate-100 text-sm font-medium">{product.name}</p>
        <p className="text-slate-500 text-xs">₹{product.price}</p>
      </div>
      <button
        onClick={() => dispatch({ type: "ADD_ITEM", product })}
        className="text-xs bg-amber-400 text-slate-900 font-medium px-3 py-1.5 rounded-md hover:bg-amber-300"
      >
        Add
      </button>
    </div>
  );
}
